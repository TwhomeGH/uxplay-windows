{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug uxplay-windows (dev)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}\\build\\dev\\uxplay-windows.exe",
            "args": [
                "--engine-debug"
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}\\build\\dev",
            "environment": [
                {
                    "name": "PATH",
                    "value": "H:\\FIX_VIAP\\msys64\\ucrt64\\bin;${workspaceFolder}\\build\\dev;${env:PATH}"
                },
                {
                    "name": "QT_PLUGIN_PATH",
                    "value": "H:\\FIX_VIAP\\msys64\\ucrt64\\share\\qt6\\plugins"
                },
                {
                    "name": "GST_PLUGIN_PATH",
                    "value": "H:\\FIX_VIAP\\msys64\\ucrt64\\lib\\gstreamer-1.0"
                }
            ],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "H:\\FIX_VIAP\\msys64\\ucrt64\\bin\\gdb.exe",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Use Intel disassembly",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                },
                {
                    "description": "Put UCRT64 runtime on the inferior PATH",
                    "text": "-gdb-set environment PATH \"H:\\\\FIX_VIAP\\\\msys64\\\\ucrt64\\\\bin;${workspaceFolder}\\\\build\\\\dev;${env:PATH}\"",
                    "ignoreFailures": false
                },
                {
                    "description": "Point Qt at the UCRT64 plugins",
                    "text": "-gdb-set environment QT_PLUGIN_PATH H:\\\\FIX_VIAP\\\\msys64\\\\ucrt64\\\\share\\\\qt6\\\\plugins",
                    "ignoreFailures": false
                },
                {
                    "description": "Point GStreamer at the UCRT64 plugins",
                    "text": "-gdb-set environment GST_PLUGIN_PATH H:\\\\FIX_VIAP\\\\msys64\\\\ucrt64\\\\lib\\\\gstreamer-1.0",
                    "ignoreFailures": false
                }
            ],
            "preLaunchTask": "build-dev"
        }
    ]
}
